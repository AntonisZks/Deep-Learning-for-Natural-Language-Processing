    "def finalize_3d_plot(ax):\n",
    "    ''' Finalizes the 3D plot with legend and layout adjustments '''\n",
    "    ax.legend(loc='best', fontsize=10, labelcolor=text_color).get_frame().set_facecolor(patch_background_color)\n",
