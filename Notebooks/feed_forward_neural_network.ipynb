    "\n",
    "    # Unzip\n",
    "    print(\"Unzipping...\")\n",
    "    with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
    "        zip_ref.extractall(glove_folder)\n",
    "    print(\"Done! GloVe is saved to:\", glove_folder)\n",
    "\n",
    "else:\n",
    "    print(\"GloVe embeddings already downloaded.\")\n",
