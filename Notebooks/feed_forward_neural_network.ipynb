    "def get_google_news_negative_300_tweet_vector(tweet, model):\n",
    "    words = tweet.split()\n",
    "    vectors = []\n",
    "\n",
    "    for word in words:\n",
    "        if word in model:\n",
    "            vectors.append(model[word])\n",
    "    \n",
    "    if len(vectors) == 0:\n",
    "        return np.zeros(model.vector_size)\n",
    "    \n",
    "    return np.mean(vectors, axis=0)"
   ]
  },
