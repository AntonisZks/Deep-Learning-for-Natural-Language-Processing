    "# Define a dictionary of optimizers for the model\n",
    "optimizers = {\n",
    "    'SGD': torch.optim.SGD,\n",
    "    'Adam': torch.optim.Adam,\n",
    "    'RMSprop': torch.optim.RMSprop,\n",
    "    'Adagrad': torch.optim.Adagrad,\n",
    "    'AdamW': torch.optim.AdamW\n",
    "}"
   ]
